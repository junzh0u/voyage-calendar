# Copy to .env next to compose.yaml. A feed URL is a credential: whoever holds
# it reads the calendar, so .env stays out of git.
VOYAGE_CALENDAR_ICS_URLS=https://calendar.google.com/calendar/ical/<id>/private-<token>/basic.ics https://calendar.google.com/calendar/ical/<other>/private-<token>/basic.ics
VOYAGE_CALENDAR_EMAIL=you@example.com
# The Kindle, as the container sees it: an address (or user@address)
VOYAGE_CALENDAR_HOST=192.168.1.50
# The zone the agenda is rendered in
TZ=America/Los_Angeles
