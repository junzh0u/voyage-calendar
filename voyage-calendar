def _test():
    # The agenda and the page render in the process's local zone, and the
    # fixtures below are written for Los Angeles: pin the zone so the suite
    # passes on a UTC runner (CI, a container). tzset() is what makes a TZ
    # change visible to localtime(); a build without it needs TZ in the
    # environment before start.
    os.environ["TZ"] = "America/Los_Angeles"
    if hasattr(time, "tzset"):
        time.tzset()

    failures = []

    def check(name, cond, detail=""):
        print(("ok   " if cond else "FAIL ") + name + (" " + str(detail) if not cond else ""))
        if not cond:
            failures.append(name)

    la = zone("America/Los_Angeles")
    check("zoneinfo resolves a TZID", la is not None or zoneinfo is None)

    def wall(instances, tz=la):
        out = []
        for i in instances:
            if i.all_day:
                out.append(i.start.isoformat())
            else:
                out.append(i.start.astimezone(tz).strftime("%Y-%m-%dT%H:%M"))
        return out

    def feed(*events):
        body = "\n".join("BEGIN:VEVENT\n{}\nEND:VEVENT".format(e.strip()) for e in events)
        return "BEGIN:VCALENDAR\r\nVERSION:2.0\r\n{}\r\nEND:VCALENDAR\r\n".format(body.replace("\n", "\r\n"))

    def window(start, days=DAYS):
        ws = localize(dt.datetime.strptime(start, "%Y-%m-%d"), la)
        return ws, ws + dt.timedelta(days=days)

    def run(text, start="2026-09-03", days=DAYS, email=None):
        events, overrides = load_events(parse_components(text))
        return expand(events, overrides, *window(start, days), email=email)

    # parsing
    check("unfold joins continuation lines",
          unfold("SUMMARY:one\r\n  two\r\nX:y") == ["SUMMARY:one two", "X:y"])
    check("params parsed and quotes respected",
          parse_line('DTSTART;TZID="America/Los_Angeles";VALUE=DATE-TIME:20260903T090000')
          == ("DTSTART", {"TZID": "America/Los_Angeles", "VALUE": "DATE-TIME"}, "20260903T090000"))
    check("text escapes", unescape_text(r"a\, b\; c\nd\\e") == "a, b; c\nd\\e")
    check("duration", parse_duration("P1DT2H30M") == dt.timedelta(days=1, hours=2, minutes=30)
          and parse_duration("-PT15M") == dt.timedelta(minutes=-15) and parse_duration("P2W") == dt.timedelta(weeks=2))
    check("rrule lists", parse_rrule("FREQ=WEEKLY;BYDAY=mo,WE;INTERVAL=2")
          == {"FREQ": "WEEKLY", "BYDAY": ["MO", "WE"], "INTERVAL": "2"})
    check("VALARM stays out of the event", len(parse_components(
        feed("UID:a\nDTSTART:20260903T170000Z\nBEGIN:VALARM\nTRIGGER:-PT10M\nEND:VALARM\nSUMMARY:x"))[0]) == 3)

    # single events, zones, all-day
    single = feed("UID:s\nDTSTART;TZID=America/Los_Angeles:20260903T090000\nDTEND;TZID=America/Los_Angeles:20260903T093000\nSUMMARY:Standup")
    inst = run(single)
    check("timed event lands on its LA wall clock", wall(inst) == ["2026-09-03T09:00"], wall(inst))
    check("duration from DTEND", inst[0].end - inst[0].start == dt.timedelta(minutes=30))
    utc = run(feed("UID:u\nDTSTART:20260903T160000Z\nDTEND:20260903T170000Z\nSUMMARY:UTC"))
    check("UTC event converts (16:00Z is 9:00 PDT)", wall(utc) == ["2026-09-03T09:00"], wall(utc))
    allday = run(feed("UID:d\nDTSTART;VALUE=DATE:20260904\nDTEND;VALUE=DATE:20260906\nSUMMARY:Trip"))
    check("all-day keeps dates, end exclusive", allday and allday[0].all_day
          and (allday[0].start, allday[0].end) == (dt.date(2026, 9, 4), dt.date(2026, 9, 6)), allday)
    check("event outside the window is dropped",
          run(feed("UID:o\nDTSTART;TZID=America/Los_Angeles:20260915T090000\nSUMMARY:Later")) == [])
    check("event straddling the window start is kept", wall(run(feed(
        "UID:x\nDTSTART;TZID=America/Los_Angeles:20260902T230000\nDTEND;TZID=America/Los_Angeles:20260903T010000\nSUMMARY:Late")))
        == ["2026-09-02T23:00"])
    check("cancelled event skipped",
          run(feed("UID:c\nDTSTART;TZID=America/Los_Angeles:20260903T090000\nSTATUS:CANCELLED\nSUMMARY:x")) == [])
    declined = feed("UID:i\nDTSTART;TZID=America/Los_Angeles:20260903T090000\nSUMMARY:Invite\n"
                    "ATTENDEE;PARTSTAT=DECLINED;CN=Me:mailto:Me@Example.com\nATTENDEE;PARTSTAT=ACCEPTED:mailto:o@x.com")
    check("declined invitation skipped for my address", run(declined, email="me@example.com") == [])
    check("declined by someone else still shown", len(run(declined, email="o@x.com")) == 1)
    check("no address configured: shown", len(run(declined)) == 1)

    # recurrence
    daily = feed("UID:r\nDTSTART;TZID=America/Los_Angeles:20260101T080000\nDTEND;TZID=America/Los_Angeles:20260101T081500\nRRULE:FREQ=DAILY;INTERVAL=2\nSUMMARY:Alt")
    got = wall(run(daily, days=4))
    check("daily interval 2 from a distant start", got == ["2026-09-04T08:00", "2026-09-06T08:00"], got)
    weekly = feed("UID:w\nDTSTART;TZID=America/Los_Angeles:20260825T100000\nRRULE:FREQ=WEEKLY;BYDAY=TU,TH;INTERVAL=2;WKST=SU\nSUMMARY:Biweekly")
    got = wall(run(weekly, days=14))
    check("weekly BYDAY with interval and WKST", got == ["2026-09-08T10:00", "2026-09-10T10:00"], got)
    exdated = feed("UID:e\nDTSTART;TZID=America/Los_Angeles:20260827T100000\nRRULE:FREQ=WEEKLY\n"
                   "EXDATE;TZID=America/Los_Angeles:20260903T100000\nSUMMARY:Weekly")
    got = wall(run(exdated, days=8))
    check("EXDATE removes an instance", got == ["2026-09-10T10:00"], got)
    exdated_utc = feed("UID:e2\nDTSTART;TZID=America/Los_Angeles:20260827T100000\nRRULE:FREQ=WEEKLY\n"
                       "EXDATE:20260903T170000Z\nSUMMARY:Weekly")
    check("EXDATE written in UTC still matches", wall(run(exdated_utc, days=8)) == ["2026-09-10T10:00"])
    monthly = feed("UID:m\nDTSTART;TZID=America/Los_Angeles:20260108T120000\nRRULE:FREQ=MONTHLY;BYDAY=2TH\nSUMMARY:2nd Thu")
    got = wall(run(monthly, days=14))
    check("monthly ordinal BYDAY", got == ["2026-09-10T12:00"], got)
    lastfri = feed("UID:lf\nDTSTART;TZID=America/Los_Angeles:20260130T120000\nRRULE:FREQ=MONTHLY;BYDAY=-1FR\nSUMMARY:Last Fri")
    got = wall(run(lastfri, start="2026-09-21", days=7))
    check("monthly -1FR", got == ["2026-09-25T12:00"], got)
    monthday = feed("UID:md\nDTSTART;TZID=America/Los_Angeles:20260131T090000\nRRULE:FREQ=MONTHLY\nSUMMARY:31st")
    check("monthly on the 31st skips short months", wall(run(monthday, start="2026-09-28", days=7)) == []
          and wall(run(monthday, start="2026-10-28", days=7)) == ["2026-10-31T09:00"])
    yearly = feed("UID:y\nDTSTART;VALUE=DATE:19900905\nDTEND;VALUE=DATE:19900906\nRRULE:FREQ=YEARLY\nSUMMARY:Birthday")
    got = wall(run(yearly))
    check("yearly all-day", got == ["2026-09-05"], got)
    counted = feed("UID:n\nDTSTART;TZID=America/Los_Angeles:20260901T090000\nRRULE:FREQ=DAILY;COUNT=3\nSUMMARY:Three")
    got = wall(run(counted))
    check("COUNT bounds the series", got == ["2026-09-03T09:00"], got)
    until = feed("UID:t\nDTSTART;TZID=America/Los_Angeles:20260901T090000\nRRULE:FREQ=DAILY;UNTIL=20260904T160000Z\nSUMMARY:Until")
    got = wall(run(until))
    check("UNTIL in UTC is inclusive on the wall clock", got == ["2026-09-03T09:00", "2026-09-04T09:00"], got)
    until_date = feed("UID:td\nDTSTART;VALUE=DATE:20260901\nRRULE:FREQ=DAILY;UNTIL=20260904\nSUMMARY:Days")
    got = wall(run(until_date))
    check("UNTIL date for an all-day series", got == ["2026-09-03", "2026-09-04"], got)
    moved = feed("UID:v\nDTSTART;TZID=America/Los_Angeles:20260827T100000\nRRULE:FREQ=WEEKLY\nSUMMARY:Sync",
                 "UID:v\nRECURRENCE-ID;TZID=America/Los_Angeles:20260903T100000\n"
                 "DTSTART;TZID=America/Los_Angeles:20260904T150000\nSUMMARY:Sync (moved)")
    got = [(w, i.title) for w, i in zip(wall(run(moved, days=8)), run(moved, days=8))]
    check("RECURRENCE-ID override replaces the instance",
          got == [("2026-09-04T15:00", "Sync (moved)"), ("2026-09-10T10:00", "Sync")], got)
    cancelled_one = feed("UID:v2\nDTSTART;TZID=America/Los_Angeles:20260827T100000\nRRULE:FREQ=WEEKLY\nSUMMARY:Sync",
                         "UID:v2\nRECURRENCE-ID;TZID=America/Los_Angeles:20260903T100000\n"
                         "DTSTART;TZID=America/Los_Angeles:20260903T100000\nSTATUS:CANCELLED\nSUMMARY:Sync")
    check("cancelled override drops just that instance", wall(run(cancelled_one, days=8)) == ["2026-09-10T10:00"])
    rdate = feed("UID:rd\nDTSTART;TZID=America/Los_Angeles:20260801T100000\nRRULE:FREQ=MONTHLY\n"
                 "RDATE;TZID=America/Los_Angeles:20260905T100000\nSUMMARY:Extra")
    check("RDATE adds an instance", wall(run(rdate)) == ["2026-09-05T10:00"])
    unsupported = feed("UID:h\nDTSTART;TZID=America/Los_Angeles:20260903T090000\nRRULE:FREQ=HOURLY;COUNT=5\nSUMMARY:Hourly")
    check("unsupported FREQ yields the start only", wall(run(unsupported)) == ["2026-09-03T09:00"])
    dst = feed("UID:dst\nDTSTART;TZID=America/Los_Angeles:20260302T090000\nRRULE:FREQ=WEEKLY\nSUMMARY:Mon 9am")
    check("weekly keeps its wall clock across DST",
          all(w.endswith("T09:00") for w in wall(run(dst, start="2026-11-02", days=7))))

    # agenda rows
    now = localize(dt.datetime(2026, 9, 3, 12, 0), la)
    rows_feed = feed("UID:1\nDTSTART;TZID=America/Los_Angeles:20260903T090000\nDTEND;TZID=America/Los_Angeles:20260903T093000\nSUMMARY:Past",
                     "UID:2\nDTSTART;TZID=America/Los_Angeles:20260903T113000\nDTEND;TZID=America/Los_Angeles:20260903T123000\nSUMMARY:Now",
                     "UID:3\nDTSTART;TZID=America/Los_Angeles:20260903T220000\nDTEND;TZID=America/Los_Angeles:20260904T010000\nSUMMARY:Overnight",
                     "UID:4\nDTSTART;VALUE=DATE:20260902\nDTEND;VALUE=DATE:20260905\nSUMMARY:Trip",
                     "UID:5\nDTSTART;TZID=America/Los_Angeles:20260903T140000\nSUMMARY:Reminder")
    inst = run(rows_feed)
    days = agenda(inst, dt.date(2026, 9, 3), now)
    today_rows = [(r[0], r[1], r[2]) for r in days[0][1]]
    check("today's rows: all-day first, then by time, with states", today_rows == [
        ("Day 2 of 3", "Trip", "allday"), ("9:00 – 9:30 AM", "Past", "past"),
        ("11:30 AM – 12:30 PM", "Now", "now"), ("2:00 PM", "Reminder", "later"),
        ("10:00 PM →", "Overnight", "later")], today_rows)
    tomorrow_rows = [(r[0], r[1]) for r in days[1][1]]
    check("overnight continues into tomorrow", tomorrow_rows == [("Day 3 of 3", "Trip"), ("→ 1:00 AM", "Overnight")],
          tomorrow_rows)
    check("agenda spans DAYS days", len(days) == DAYS and days[-1][0] == dt.date(2026, 9, 9))
    text = agenda_text(days)
    check("text agenda marks the running event", "▶ 11:30 AM – 12:30 PM  Now" in text, text)

    page = render_html(days, now, stale_feeds=1, feed_count=2)
    check("page names today and the events", "Thursday" in page and "Overnight" in page and "Trip" in page)
    check("past rows collapse into the Earlier line", "Earlier</span>Past</div>" in page and 'row past' not in page)
    check("today's running row has a two-line time", "<b>11:30 AM</b><small>– 12:30 PM</small>" in page)
    check("page flags a stale feed", "1 of 2 calendars from cache" in page)
    check("month grid marks today", 'class="today"><span>3</span>' in page)
    check("html escaped", "&lt;" in render_html(agenda(run(feed(
        "UID:h\nDTSTART;TZID=America/Los_Angeles:20260903T090000\nSUMMARY:<b>")), dt.date(2026, 9, 3), now), now))
    many = feed(*["UID:{0}\nDTSTART;TZID=America/Los_Angeles:2026090{1}T{2:02d}0000\nSUMMARY:E{0}".format(
        i, 3 + i % 6, 6 + i % 12) for i in range(60)])
    crowded = render_html(agenda(run(many), dt.date(2026, 9, 3), now), now)
    check("crowded week gets '+N more' rows instead of overflowing", "more</div>" in crowded)
    check("crowded week says how far the page got", "through " in crowded and "not shown" in crowded)
    wide = render_html(days, now, landscape=True)
    check("landscape page rotates and splits into columns",
          'class="landscape"' in wide and 'class="left"' in wide and "Overnight" in wide)
    check("no day heading is printed without at least one row", "</h3><div class=\"more\">" not in crowded)

    check("feed URL redacted in logs", redact("https://calendar.google.com/calendar/ical/x/private-abc/basic.ics")
          == "https://calendar.google.com/…")
    try:
        feed_sources({})
        check("no feeds raises", False)
    except CalendarError as exc:
        check("no feeds raises exit 3", exc.exit_code == 3)
    check("feed sources split on whitespace", feed_sources({"VOYAGE_CALENDAR_ICS_URLS": "a\n b"}) == ["a", "b"])
    check("feed sources shed surrounding quotes", feed_sources({"VOYAGE_CALENDAR_ICS_URLS": '"a b"'}) == ["a", "b"])
    for name, script in (("keeper", KEEPER_SH), ("show", REMOTE_SHOW), ("restore", REMOTE_RESTORE)):
        proc = subprocess.run(["sh", "-n"], input=script.encode(), capture_output=True)
        check("remote {} script parses as sh".format(name), proc.returncode == 0, proc.stderr.decode())
    check("push ships the keeper verbatim", KEEPER_SH in REMOTE_SHOW and "<<'KEEPER'" in REMOTE_SHOW)
    os.environ.pop("VOYAGE_CALENDAR_SSH_KEY", None)
    check("ssh logs in as root by default", ssh_command("voyage")[-1] == "root@voyage"
          and ssh_command("me@10.0.0.9")[-1] == "me@10.0.0.9" and "-i" not in ssh_command("voyage"))
    os.environ["VOYAGE_CALENDAR_SSH_KEY"] = "/ssh/key"
    keyed = ssh_command("voyage")
    check("ssh with a key offers only it and pins the host key under the cache",
          keyed[keyed.index("-i") + 1] == "/ssh/key" and "IdentitiesOnly=yes" in keyed
          and "UserKnownHostsFile=" + os.path.join(CACHE_DIR, "known_hosts") in keyed)
    del os.environ["VOYAGE_CALENDAR_SSH_KEY"]

    if chrome_binary():
        work = tempfile.mkdtemp(prefix="voyage-calendar-test-")
        try:
            png = screenshot(page, os.path.join(work, "t.png"))
        finally:
            shutil.rmtree(work, ignore_errors=True)
        size = (int.from_bytes(png[16:20], "big"), int.from_bytes(png[20:24], "big"))
        check("Chrome renders the panel size", png[:8] == b"\x89PNG\r\n\x1a\n" and size == (WIDTH, HEIGHT), size)
    else:
        print("skip Chrome screenshot (no Chrome or Chromium found)")

    print("{} failure(s)".format(len(failures)) if failures else "all passed")
    return 1 if failures else 0


if __name__ == "__main__":
    if sys.argv[1:] == ["--test"]:
        sys.exit(_test())
    sys.exit(main(sys.argv[1:]))
