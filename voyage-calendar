# --- rendering and pushing -----------------------------------------------------

def chrome_binary():
    """The Chrome or Chromium to render with, None when none is installed."""
    configured = os.environ.get("VOYAGE_CALENDAR_CHROME")
    if configured:
        return configured
    for candidate in CHROME_CANDIDATES:
        if os.path.isabs(candidate):
            if os.path.exists(candidate):
                return candidate
        elif shutil.which(candidate):
            return shutil.which(candidate)
    return None


def screenshot(html_text, png_path, timeout=45):
    """Render the page with headless Chrome to png_path. Chrome writes the
    shot within a second but tends to linger afterwards, so wait for its
    confirmation line and then stop it."""
    chrome = chrome_binary()
    if not chrome:
        raise CalendarError("no Chrome or Chromium found (set VOYAGE_CALENDAR_CHROME)")
    work = tempfile.mkdtemp(prefix="voyage-calendar-")
    html_path = os.path.join(work, "page.html")
    with open(html_path, "w", encoding="utf-8") as fh:
        fh.write(html_text)
    args = [chrome, "--headless=new", "--no-first-run", "--no-default-browser-check",
            "--disable-extensions", "--disable-sync", "--disable-background-networking",
            "--disable-gpu", "--disable-dev-shm-usage", "--hide-scrollbars",
            "--force-device-scale-factor=1",
            "--window-size={},{}".format(WIDTH, HEIGHT),
            "--user-data-dir=" + os.path.join(work, "profile"),
            "--screenshot=" + png_path, "file://" + html_path]
    if hasattr(os, "geteuid") and os.geteuid() == 0:
        args.append("--no-sandbox")  # Chromium refuses to sandbox as root, which is what a container runs it as
    try:
        proc = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    except OSError as exc:
        shutil.rmtree(work, ignore_errors=True)
        raise CalendarError("could not run Chrome: {}".format(exc))
    deadline = time.time() + timeout
    written, last_line = False, b""
    try:
        while time.time() < deadline:
            ready, _, _ = select.select([proc.stderr], [], [], 0.5)
            if ready:
                line = proc.stderr.readline()
                if not line:
                    break
                last_line = line.strip() or last_line
                if b"written to file" in line:
                    written = True
                    break
            elif proc.poll() is not None:
                break
    finally:
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(5)
            except subprocess.TimeoutExpired:
                proc.kill()
        shutil.rmtree(work, ignore_errors=True)
    if not written and not (os.path.exists(png_path) and os.path.getsize(png_path)):
        raise CalendarError("{} produced no screenshot within {}s{}".format(
            chrome, timeout, ": " + last_line.decode("utf-8", "replace") if last_line else ""))
    with open(png_path, "rb") as fh:
        return fh.read()


def ssh_command(host):
    """ssh argv up to (and including) the target, from the environment."""
    cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", "-o", "StrictHostKeyChecking=accept-new"]
    key = os.environ.get("VOYAGE_CALENDAR_SSH_KEY")
    if key:
        os.makedirs(CACHE_DIR, exist_ok=True)
        cmd += ["-i", key, "-o", "IdentitiesOnly=yes",  # Dropbear caps auth attempts: offer nothing else
                "-o", "UserKnownHostsFile=" + os.path.join(CACHE_DIR, "known_hosts")]
    cmd.append(host if "@" in host else "root@" + host)
    return cmd


def kindle(host, script, stdin=b"", timeout=180):
    try:
        proc = subprocess.run(ssh_command(host) + [script], input=stdin, capture_output=True, timeout=timeout)
    except OSError as exc:
        raise CalendarError("could not run ssh: {}".format(exc))
    except subprocess.TimeoutExpired:
        raise CalendarError("ssh {} timed out".format(host))
    if proc.returncode != 0:
        step = {10: "storing the image", 11: "stopping the reader framework",
                12: "keeping powerd awake", 13: "fbink"}.get(proc.returncode, "ssh")
        detail = proc.stderr.decode("utf-8", "replace").strip().splitlines()
        raise CalendarError("{} on {} failed (exit {}){}".format(
            step, host, proc.returncode, ": " + detail[-1] if detail else ""))


# --- main --------------------------------------------------------------------

def build(sources, email, now):
    """(days, stale_feeds) — the agenda from every feed."""
    components, stale = [], 0
    for source in sources:
        text, was_stale = fetch_feed(source)
        stale += was_stale
        components.extend(parse_components(text))
    events, overrides = load_events(components)
    today = now.date()
    window_start = dt.datetime.combine(today, dt.time()).astimezone()
    window_end = window_start + dt.timedelta(days=DAYS)
    instances = expand(events, overrides, window_start, window_end, email)
    return agenda(instances, today, now), stale


def main(argv):
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    png_path = html_path = every = None
    rest, args = [], list(argv)
    while args:
        arg = args.pop(0)
        if arg in ("--png", "--html", "--every"):
            if not args:
                print("voyage-calendar: {} needs a value".format(arg), file=sys.stderr)
                return 2
            value = args.pop(0)
            if arg == "--png":
                png_path = value
            elif arg == "--html":
                html_path = value
            else:
                try:
                    every = int(value)
                    if every <= 0:
                        raise ValueError
                except ValueError:
                    print("voyage-calendar: --every needs a positive number of seconds", file=sys.stderr)
                    return 2
        else:
            rest.append(arg)
    flags = ("-n", "--dry-run", "--restore", "--landscape")
    unknown = [arg for arg in rest if arg not in flags]
    usage = ("usage: voyage-calendar [--landscape] [--png PATH] [--html PATH] [--every SECS] "
             "[-n | --dry-run | --restore | --test | -h]")
    if unknown:
        print("voyage-calendar: invalid argument(s): {}".format(" ".join(unknown)), file=sys.stderr)
        print(usage, file=sys.stderr)
        return 2
    if every and ("--restore" in rest or "-n" in rest or "--dry-run" in rest):
        print("voyage-calendar: --every only repeats the default mode", file=sys.stderr)
        print(usage, file=sys.stderr)
        return 2
    if every is None:
        return run(rest, png_path, html_path)
    while True:
        started = time.time()
        run(rest, png_path, html_path)
        time.sleep(max(0, every - (time.time() - started)))


def run(rest, png_path, html_path):
    """One round of the mode in `rest`; the process exit code."""
    host = os.environ.get("VOYAGE_CALENDAR_HOST") or "voyage"
    dry_run = "-n" in rest or "--dry-run" in rest
    try:
        if "--restore" in rest:
            kindle(host, REMOTE_RESTORE)
            say("{}: reader UI restored".format(host))
            return 0
        sources = feed_sources()
        now = dt.datetime.now().astimezone()
        days, stale = build(sources, os.environ.get("VOYAGE_CALENDAR_EMAIL"), now)
        page = render_html(days, now, stale, len(sources), landscape="--landscape" in rest)
        if html_path:
            with open(html_path, "w", encoding="utf-8") as fh:
                fh.write(page)
        if dry_run:
            print(agenda_text(days))
            if png_path:
                screenshot(page, png_path)
                print("screenshot: {}".format(png_path))
            if stale:
                say("voyage-calendar: {} of {} feed(s) served from cache".format(stale, len(sources)),
                    file=sys.stderr)
            return 0
        work = tempfile.mkdtemp(prefix="voyage-calendar-")
        try:
            png = screenshot(page, png_path or os.path.join(work, "dash.png"))
        finally:
            shutil.rmtree(work, ignore_errors=True)
        kindle(host, REMOTE_SHOW, png)
        total = sum(len(rows) for _, rows in days)
        say("{}: painted {} event{} over {} days{}".format(
            host, total, "" if total == 1 else "s", DAYS,
            " ({} of {} feeds from cache)".format(stale, len(sources)) if stale else ""))
    except CalendarError as exc:
        say("voyage-calendar: {}".format(exc), file=sys.stderr)
        return exc.exit_code
    return 0


