import datetime as dt
import hashlib
import html
import os
import select
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

try:
    import zoneinfo
except ImportError:  # Python 3.8: TZIDs fall back to the local zone
    zoneinfo = None

WIDTH, HEIGHT = 1072, 1448  # the Voyage's panel, portrait
DAYS = 7  # today plus the week ahead
# chromium-browser last: on Ubuntu it is a snap stub that only prints an error
CHROME_CANDIDATES = ("/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
                     "chromium", "google-chrome", "google-chrome-stable", "chromium-browser")
CACHE_DIR = os.environ.get("VOYAGE_CALENDAR_CACHE_DIR") or os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "voyage-calendar")
REMOTE_DIR = "/mnt/us/voyage-calendar"
WEEKDAYS = ("MO", "TU", "WE", "TH", "FR", "SA", "SU")  # index == date.weekday()
MONTH_GRID_STARTS_ON = 6  # Sunday, as Google Calendar shows it
MAX_PERIODS = 20000  # recurrence periods walked before giving up on a rule

# The Kindle side, run by sh with the PNG on stdin. USBNetwork's bin holds
# fbink; /sbin holds upstart's stop/start; pidof is busybox. cvm is the Java
# VM the reader framework runs in — stopped, nothing repaints over the image.
# preventScreenSaver keeps powerd (and with it Wi-Fi) awake; it resets on
# reboot, so it is set on every push. The power button still suspends the
# device, and after the wake nothing asks the connection manager to
# reassociate once the framework is gone — the keeper loop below does, so
# the next push gets through. It is (re)written on every push and started
# when no instance is running.
KEEPER_SH = """#!/bin/sh
# voyage-calendar keeper — written by the Mac's push; do not edit here.
# Brings Wi-Fi back whenever wifid reports it down (after a suspend/resume,
# typically), so the calendar pushes keep reaching this Kindle.
export PATH=/mnt/us/usbnet/bin:/usr/sbin:/sbin:/usr/bin:/bin
log={dir}/keeper.log
essid=
while true; do
    state=$(timeout -t 10 lipc-get-prop -s com.lab126.wifid cmState 2>/dev/null)
    if [ "$state" = CONNECTED ]; then
        essid=$(wpa_cli -i wlan0 status 2>/dev/null | sed -n 's/^ssid=//p')
    else
        [ -f $log ] && [ $(wc -c < $log) -gt 20000 ] && mv -f $log $log.old
        echo "$(date '+%Y-%m-%d %H:%M:%S') wifi ${{state:-unknown}}: reconnecting${{essid:+ to $essid}}" >> $log
        # the sequence KOReader uses, then the connection manager's own
        # reconnect for the network we last saw
        lipc-set-prop com.lab126.cmd wirelessEnable 1
        lipc-set-prop com.lab126.wifid enable 1
        [ -n "$essid" ] && lipc-set-prop com.lab126.cmd ensureConnection "wifi:$essid"
        sleep 30
    fi
    sleep 15
done
""".format(dir=REMOTE_DIR)
# pids of running keepers. The Kindle's busybox ps prints only "sh" for a
# script, so match the argv in /proc — as a case pattern, not grep, whose
# own argv (and this remote shell's) would match too.
REMOTE_KEEPERS = """keepers() {
    for p in /proc/[0-9]*; do
        case "$(tr '\\0' ' ' < $p/cmdline 2>/dev/null)" in "sh $d/keeper.sh "*) echo ${p#/proc/};; esac
    done
}"""
REMOTE_SHOW = """
export PATH=/mnt/us/usbnet/bin:/usr/sbin:/sbin:/usr/bin:/bin
d={dir}
mkdir -p $d && cat > $d/dash.png.new && mv -f $d/dash.png.new $d/dash.png || exit 10
if pidof cvm >/dev/null 2>&1; then stop framework >/dev/null 2>&1 || exit 11; fi
lipc-set-prop com.lab126.powerd preventScreenSaver 1 || exit 12
fbink -q -c -f -g file=$d/dash.png || exit 13
cat > $d/keeper.sh.new <<'KEEPER'
{keeper}KEEPER
{keepers}
if ! cmp -s $d/keeper.sh.new $d/keeper.sh; then mv -f $d/keeper.sh.new $d/keeper.sh; changed=1; fi
rm -f $d/keeper.sh.new
set -- $(keepers)
if [ -n "$changed" ] || [ $# -ne 1 ]; then
    [ $# -gt 0 ] && kill "$@" 2>/dev/null
    nohup setsid sh $d/keeper.sh </dev/null >/dev/null 2>&1 &
fi
""".format(dir=REMOTE_DIR, keeper=KEEPER_SH, keepers=REMOTE_KEEPERS)
REMOTE_RESTORE = """
export PATH=/mnt/us/usbnet/bin:/usr/sbin:/sbin:/usr/bin:/bin
d={dir}
{keepers}
kill $(keepers) 2>/dev/null
lipc-set-prop com.lab126.powerd preventScreenSaver 0
pidof cvm >/dev/null 2>&1 || start framework >/dev/null 2>&1
""".format(dir=REMOTE_DIR, keepers=REMOTE_KEEPERS)


def say(message, file=sys.stdout):
    if os.environ.get("LOG_TIMESTAMP"):
        message = time.strftime("%Y-%m-%d %H:%M:%S ") + message
    print(message, file=file)


class CalendarError(Exception):
    def __init__(self, message, exit_code=1):
        super().__init__(message)
        self.exit_code = exit_code


# --- iCalendar parsing ---------------------------------------------------------

def unfold(text):
    """Content lines of an iCalendar text, with folded continuations joined."""
    lines = []
    for raw in text.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if raw[:1] in (" ", "\t") and lines:
            lines[-1] += raw[1:]
        elif raw:
            lines.append(raw)
    return lines


def parse_line(line):
    """(name, params, value) of a content line: NAME;P=V;Q="a:b":value."""
    i, quoted = 0, False
    while i < len(line):
        c = line[i]
        if c == '"':
            quoted = not quoted
        elif c == ":" and not quoted:
            break
        i += 1
    head, value = line[:i], line[i + 1:]
    parts, buf, quoted = [], "", False
    for c in head:
        if c == '"':
            quoted = not quoted
        elif c == ";" and not quoted:
            parts.append(buf)
            buf = ""
            continue
        buf += c
    parts.append(buf)
    params = {}
    for part in parts[1:]:
        key, _, val = part.partition("=")
        params[key.upper()] = val.strip('"')
    return parts[0].upper(), params, value


def unescape_text(value):
    out, i = "", 0
    while i < len(value):
        c = value[i]
        if c == "\\" and i + 1 < len(value):
            nxt = value[i + 1]
            out += "\n" if nxt in "nN" else nxt
            i += 2
        else:
            out += c
            i += 1
    return out


def parse_components(text):
    """VEVENT components as lists of (name, params, value), nested ones
    (VALARM) dropped."""
    events, stack = [], []
    for line in unfold(text):
        name, params, value = parse_line(line)
        if name == "BEGIN":
            stack.append((value.upper(), []))
        elif name == "END":
            if not stack:
                continue
            kind, props = stack.pop()
            if kind == "VEVENT":
                events.append(props)
        elif stack:
            stack[-1][1].append((name, params, value))
    return events


def zone(tzid):
    """tzinfo for a TZID, None (meaning the local zone) when unknown."""
    if not tzid or zoneinfo is None:
        return None
    try:
        return zoneinfo.ZoneInfo(tzid)
    except Exception:
        return None


def parse_datetime(value, params):
    """(naive wall-clock datetime, tz, all_day) of a DATE / DATE-TIME value.
    tz is the zone the wall clock is in: a tzinfo, or None for the local
    zone (also the fallback for a TZID zoneinfo cannot resolve)."""
    value = value.strip()
    if params.get("VALUE") == "DATE" or len(value) == 8:
        return dt.datetime.strptime(value, "%Y%m%d"), None, True
    if value.endswith("Z"):
        return dt.datetime.strptime(value[:-1], "%Y%m%dT%H%M%S"), dt.timezone.utc, False
    return dt.datetime.strptime(value[:15], "%Y%m%dT%H%M%S"), zone(params.get("TZID")), False


def localize(naive, tz):
    """Aware local-zone datetime of a wall-clock time in tz (None: local)."""
    if tz is None:
        return naive.astimezone()
    return naive.replace(tzinfo=tz).astimezone()


def in_zone(naive, tz, target):
    """Wall clock of `naive` (in tz) rewritten in the `target` zone."""
    aware = localize(naive, tz)
    if target is None:
        return aware.replace(tzinfo=None)
    return aware.astimezone(target).replace(tzinfo=None)


def parse_duration(value):
    """timedelta of an RFC 5545 DURATION (P1DT2H30M, -PT15M, P2W)."""
    sign = -1 if value.startswith("-") else 1
    value = value.lstrip("+-")
    if not value.startswith("P"):
        raise ValueError(value)
    days = seconds = 0
    number, in_time = "", False
    for c in value[1:]:
        if c.isdigit():
            number += c
        elif c == "T":
            in_time = True
        else:
            n = int(number or 0)
            number = ""
            if c == "W":
                days += 7 * n
            elif c == "D":
                days += n
            elif c == "H":
                seconds += 3600 * n
            elif c == "M" and in_time:
                seconds += 60 * n
            elif c == "S":
                seconds += n
    return sign * dt.timedelta(days=days, seconds=seconds)


def parse_rrule(value):
    rule = {}
    for part in value.split(";"):
        key, _, val = part.partition("=")
        key = key.upper()
        if key in ("BYDAY", "BYMONTHDAY", "BYMONTH", "BYSETPOS"):
            rule[key] = [v.strip().upper() for v in val.split(",") if v.strip()]
        else:
            rule[key] = val.strip().upper()
    return rule


class Event(object):
    def __init__(self, props):
        self.uid = self.summary = self.location = self.status = ""
        self.rrule = None
        self.exdates, self.rdates = set(), []
        self.recurrence_id = None
        self.declined_by = set()
        self.start = self.tz = self.all_day = None
        self.duration = None
        end = None
        for name, params, value in props:
            if name == "UID":
                self.uid = value
            elif name == "SUMMARY":
                self.summary = unescape_text(value).strip()
            elif name == "LOCATION":
                self.location = unescape_text(value).strip()
            elif name == "STATUS":
                self.status = value.strip().upper()
            elif name == "DTSTART":
                self.start, self.tz, self.all_day = parse_datetime(value, params)
            elif name == "DTEND":
                end = parse_datetime(value, params)
            elif name == "DURATION":
                self.duration = parse_duration(value)
            elif name == "RRULE":
                self.rrule = parse_rrule(value)
            elif name in ("EXDATE", "RDATE"):
                for v in value.split(","):
                    naive, tz, _ = parse_datetime(v, params)
                    (self.exdates.add if name == "EXDATE" else self.rdates.append)((naive, tz))
            elif name == "RECURRENCE-ID":
                self.recurrence_id = parse_datetime(value, params)[:2]
            elif name == "ATTENDEE" and params.get("PARTSTAT", "").upper() == "DECLINED":
                self.declined_by.add(value.strip().lower().replace("mailto:", ""))
        if self.start is None:
            raise ValueError("VEVENT without DTSTART")
        if self.duration is None:
            if end is not None:
                self.duration = localize(end[0], end[1]) - localize(self.start, self.tz) \
                    if not self.all_day else end[0] - self.start
            else:
                self.duration = dt.timedelta(days=1) if self.all_day else dt.timedelta()
        # exception dates and recurrence ids are compared on the master's
        # wall clock, whatever zone they were written in
        self.exdates = {self.wall(n, tz) for n, tz in self.exdates}
        self.rdates = [self.wall(n, tz) for n, tz in self.rdates]
        if self.recurrence_id:
            self.recurrence_id = self.wall(*self.recurrence_id)

    def wall(self, naive, tz):
        if self.all_day or tz == self.tz:
            return naive
        return in_zone(naive, tz, self.tz)

    def declined(self, email):
        return bool(email) and email.lower() in self.declined_by


def weekday_index(token):
    """(ordinal or None, weekday) of a BYDAY token such as MO, 2TU, -1FR."""
    token = token.strip().upper()
    ordinal = token[:-2]
    return (int(ordinal) if ordinal else None), WEEKDAYS.index(token[-2:])


def month_days(year, month, rule, default_day):
    """Sorted days of a month matched by BYDAY / BYMONTHDAY, else the
    default day (none when the month is too short)."""
    last = calendar.monthrange(year, month)[1]
    days = set()
    if rule.get("BYDAY"):
        by_weekday = {}
        for d in range(1, last + 1):
            by_weekday.setdefault(dt.date(year, month, d).weekday(), []).append(d)
        for token in rule["BYDAY"]:
            ordinal, weekday = weekday_index(token)
            candidates = by_weekday.get(weekday, [])
            if ordinal is None:
                days.update(candidates)
            elif -len(candidates) <= ordinal <= len(candidates) and ordinal != 0:
                days.add(candidates[ordinal - 1 if ordinal > 0 else ordinal])
    elif rule.get("BYMONTHDAY"):
        for token in rule["BYMONTHDAY"]:
            n = int(token)
            d = n if n > 0 else last + 1 + n
            if 1 <= d <= last:
                days.add(d)
    elif default_day <= last:
        days.add(default_day)
    return sorted(days)


def occurrences(start, rule, limit):
    """Wall-clock starts of a recurrence in order: from `start` (naive) up to
    `limit` (naive, inclusive) or the rule's COUNT / UNTIL (naive, in the
    same wall clock). Unsupported rules yield just the start."""
    freq = rule.get("FREQ")
    interval = max(1, int(rule.get("INTERVAL", 1) or 1))
    count = int(rule["COUNT"]) if rule.get("COUNT") else None
    until = rule.get("_UNTIL")
    if until is not None and until < limit:
        limit = until
    if freq not in ("DAILY", "WEEKLY", "MONTHLY", "YEARLY"):
        if start <= limit:
            yield start
        return
    emitted = 0
    for period in range(MAX_PERIODS):
        if freq == "DAILY":
            base = start + dt.timedelta(days=period * interval)
            candidates = [base]
        elif freq == "WEEKLY":
            wkst = WEEKDAYS.index(rule.get("WKST", "MO")) if rule.get("WKST") in WEEKDAYS else 0
            week0 = start - dt.timedelta(days=(start.weekday() - wkst) % 7)
            base = week0 + dt.timedelta(weeks=period * interval)
            bydays = {weekday_index(t)[1] for t in rule.get("BYDAY") or [WEEKDAYS[start.weekday()]]}
            candidates = [base + dt.timedelta(days=d) for d in range(7)
                          if (base + dt.timedelta(days=d)).weekday() in bydays]
        else:
            months = period * interval if freq == "MONTHLY" else 0
            years = period * interval if freq == "YEARLY" else 0
            month0 = start.month - 1 + months
            year = start.year + years + month0 // 12
            base = start.replace(year=year, month=month0 % 12 + 1, day=1)
            month_list = [base.month]
            if freq == "YEARLY" and rule.get("BYMONTH"):
                month_list = sorted(int(m) for m in rule["BYMONTH"])
            candidates = []
            for month in month_list:
                for day in month_days(year, month, rule, start.day):
                    candidates.append(base.replace(month=month, day=day))
        if base > limit:
            return
        for candidate in candidates:
            if candidate < start:
                continue
            if candidate > limit:
                return
            yield candidate
            emitted += 1
            if count is not None and emitted >= count:
                return


def load_events(components, email=None):
    """(events, overrides) from parsed VEVENTs: the events to expand and,
    per UID, the master wall-clock instances that override VEVENTs replace."""
    events, overrides = [], {}
    for props in components:
        try:
            event = Event(props)
        except (ValueError, KeyError, IndexError):
            continue
        if event.recurrence_id is not None:
            overrides.setdefault(event.uid, set()).add(event.recurrence_id)
        events.append(event)
    return events, overrides


class Instance(object):
    """One occurrence: start/end are aware local datetimes, or dates (end
    exclusive) for all-day events."""

    def __init__(self, event, start, end):
        self.event = event
        self.start, self.end = start, end
        self.all_day = event.all_day
        self.title = event.summary or "(untitled)"

    def __repr__(self):
        return "<{} {} {}>".format(self.title, self.start, self.end)


def expand(events, overrides, window_start, window_end, email=None):
    """Instances overlapping [window_start, window_end) (aware local), sorted."""
    result = []
    window_start_date, window_end_date = window_start.date(), window_end.date() + dt.timedelta(days=1)
    for event in events:
        if event.status == "CANCELLED" or event.declined(email):
            continue
        replaced = overrides.get(event.uid, set()) if event.recurrence_id is None else set()
        if event.all_day:
            limit = dt.datetime.combine(window_end_date, dt.time())
        else:
            limit = in_zone(window_end.replace(tzinfo=None), None, event.tz)
        if event.rrule:
            rule = dict(event.rrule)
            if rule.get("UNTIL"):
                naive, tz, all_day = parse_datetime(rule["UNTIL"], {})
                if event.all_day and not all_day:
                    naive = naive.replace(hour=0, minute=0, second=0)
                elif all_day and not event.all_day:
                    naive = naive.replace(hour=23, minute=59, second=59)
                rule["_UNTIL"] = event.wall(naive, tz) if not event.all_day else naive
            starts = list(occurrences(event.start, rule, limit))
            starts.extend(r for r in event.rdates if r <= limit)
        else:
            starts = [event.start]
        for naive in sorted(set(starts)):
            if naive in event.exdates or naive in replaced:
                continue
            if event.all_day:
                start = naive.date()
                end = start + max(event.duration, dt.timedelta(days=1))
                if start < window_end_date and end > window_start_date:
                    result.append(Instance(event, start, end))
            else:
                start = localize(naive, event.tz)
                end = start + event.duration
                if start < window_end and max(end, start + dt.timedelta(minutes=1)) > window_start:
                    result.append(Instance(event, start, end))
    result.sort(key=lambda i: (sort_key(i.start), not i.all_day, i.title.lower()))
    return result


def sort_key(value):
    if isinstance(value, dt.datetime):
        return value.timestamp()
    return time.mktime(dt.datetime.combine(value, dt.time()).timetuple())


# --- feeds ---------------------------------------------------------------------

def feed_sources(env=os.environ):
    # Quotes around the list keep dotenv parsers happy (compose strips them,
    # `docker run --env-file` does not).
    urls = (env.get("VOYAGE_CALENDAR_ICS_URLS") or "").strip().strip("\"'").split()
    if not urls:
        raise CalendarError("VOYAGE_CALENDAR_ICS_URLS must list at least one iCal feed "
                            "(see .zshenv.secret)", 3)
    return urls


def fetch_feed(source, cache_dir=CACHE_DIR, timeout=30):
    """(ics text, stale) — stale when the download failed and the cache
    answered instead."""
    if not source.startswith(("http://", "https://")):
        with open(os.path.expanduser(source), "r", encoding="utf-8", errors="replace") as fh:
            return fh.read(), False
    cache = os.path.join(cache_dir, hashlib.sha1(source.encode("utf-8")).hexdigest() + ".ics")
    req = urllib.request.Request(source, headers={"User-Agent": "voyage-calendar (dotfiles)"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            text = resp.read().decode("utf-8", "replace")
        if "BEGIN:VCALENDAR" not in text:
            raise CalendarError("not an iCalendar feed")
    except (urllib.error.URLError, OSError, CalendarError) as exc:
        if os.path.exists(cache):
            with open(cache, "r", encoding="utf-8") as fh:
                return fh.read(), True
        raise CalendarError("{}: {}".format(redact(source), exc))
    os.makedirs(cache_dir, exist_ok=True)
    tmp = cache + ".new"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.replace(tmp, cache)
    return text, False


def redact(source):
    """A feed URL without its secret path, for logs."""
    if "://" not in source:
        return source
    scheme, _, rest = source.partition("://")
    host = rest.split("/", 1)[0]
    return "{}://{}/…".format(scheme, host)


# --- agenda ------------------------------------------------------------------

def clock(value):
    return value.strftime("%I:%M %p").lstrip("0")


def span_label(start, end):
    """9:00 – 9:30 AM, or 11:30 AM – 12:30 PM across noon."""
    if start.strftime("%p") == end.strftime("%p"):
        return "{} – {}".format(start.strftime("%I:%M").lstrip("0"), clock(end))
    return "{} – {}".format(clock(start), clock(end))


def day_entries(instances, day, now):
    """Rows for one day: (time label, title, state) with state one of
    past / now / later / allday."""
    day_start = dt.datetime.combine(day, dt.time()).astimezone()
    day_end = day_start + dt.timedelta(days=1)
    rows = []
    for inst in instances:
        if inst.all_day:
            if inst.start <= day < inst.end:
                span = (inst.end - inst.start).days
                label = "All day" if span <= 1 else "Day {} of {}".format((day - inst.start).days + 1, span)
                rows.append((label, inst.title, "allday", inst))
            continue
        effective_end = max(inst.end, inst.start + dt.timedelta(minutes=1))
        if not (inst.start < day_end and effective_end > day_start):
            continue
        if inst.start < day_start:
            label = "→ {}".format(clock(inst.end)) if inst.end < day_end else "All day"
        elif inst.end > day_end:
            label = "{} →".format(clock(inst.start))
        elif inst.end <= inst.start:
            label = clock(inst.start)
        else:
            label = span_label(inst.start, inst.end)
        if effective_end <= now:
            state = "past"
        elif inst.start <= now:
            state = "now"
        else:
            state = "later"
        rows.append((label, inst.title, state, inst))
    return rows


def agenda(instances, today, now):
    """[(date, rows)] for DAYS days from today."""
    return [(today + dt.timedelta(days=i), day_entries(instances, today + dt.timedelta(days=i), now))
            for i in range(DAYS)]


def agenda_text(days):
    lines = []
    for i, (day, rows) in enumerate(days):
        lines.append(day.strftime("%A, %B %-d, %Y") if i == 0 else day.strftime("%a %b %-d"))
        if not rows:
            lines.append("  —")
        for label, title, state, _ in rows:
            marker = {"past": "·", "now": "▶", "later": " ", "allday": " "}[state]
            lines.append("  {} {:<20} {}".format(marker, label, title))
    return "\n".join(lines)


# Layout budget (px) so the page never overflows the panel: what the CSS below
# gives each element, used to decide how many rows to print.
FOOTER_PX = 44
TODAY_HEADING_PX = 56
TODAY_ROW_PX = 104  # two lines: time start/end beside title/location
EARLIER_PX = 48
DAY_HEADING_PX = 58
DAY_ROW_PX = 60
MORE_PX = 40
# portrait: header (weekday, date, month grid) above one column
PORTRAIT_PAGE_PX = HEIGHT - 44 - 36
PORTRAIT_HEADER_PX = 320
# landscape (the page drawn 1448x1072 and rotated onto the portrait panel):
# weekday, date, month grid and today in the left column, the week in the right
LANDSCAPE_PAGE_PX = WIDTH - 40 - 32
LANDSCAPE_LEFT_HEADER_PX = 470


def esc(text):
    return html.escape(text, quote=True)


def month_grid_html(today, busy_days):
    first_weekday, last = calendar.monthrange(today.year, today.month)
    lead = (first_weekday - MONTH_GRID_STARTS_ON) % 7
    cells = [None] * lead + list(range(1, last + 1))
    while len(cells) % 7:
        cells.append(None)
    heads = "".join("<th>{}</th>".format(calendar.day_abbr[(MONTH_GRID_STARTS_ON + i) % 7][:2])
                    for i in range(7))
    rows = []
    for week in range(0, len(cells), 7):
        tds = []
        for d in cells[week:week + 7]:
            if d is None:
                tds.append("<td></td>")
                continue
            day = today.replace(day=d)
            cls = " ".join(c for c in (
                "today" if day == today else "",
                "busy" if day in busy_days and day != today else "",
                "gone" if day < today else "") if c)
            tds.append('<td class="{}"><span>{}</span></td>'.format(cls, d))
        rows.append("<tr>{}</tr>".format("".join(tds)))
    return ('<table class="month"><caption>{}</caption><tr>{}</tr>{}</table>'
            .format(today.strftime("%B %Y"), heads, "".join(rows)))


def today_html(today_rows, budget):
    """(html, px used) of today's section — what is over collapses to one
    line so what is next keeps its room late in the day."""
    parts = ['<section class="today"><h2>Today</h2>']
    used = TODAY_HEADING_PX
    earlier = [title for _, title, state, _ in today_rows if state == "past"]
    pending = [row for row in today_rows if row[2] != "past"]
    if earlier:
        parts.append('<div class="earlier"><span>Earlier</span>{}</div>'.format(esc(" · ".join(earlier))))
        used += EARLIER_PX
    if not pending:
        parts.append('<div class="empty">{}</div>'.format("Nothing more today" if earlier else "Nothing scheduled"))
        used += EARLIER_PX
    for i, (label, title, state, inst) in enumerate(pending):
        remaining_rows = len(pending) - i
        if budget - used - TODAY_ROW_PX < (MORE_PX if remaining_rows > 1 else 0):
            parts.append('<div class="more">+{} more</div>'.format(remaining_rows))
            used += MORE_PX
            break
        location = inst.event.location if "http" not in inst.event.location else ""
        if state == "allday" or " – " not in label:
            time_html = "<b>{}</b>".format(esc(label))
        else:
            time_html = "<b>{}</b><small>– {}</small>".format(esc(clock(inst.start)), esc(clock(inst.end)))
        parts.append('<div class="row {}"><div class="time">{}</div><div class="title">{}{}</div></div>'
                     .format(state, time_html, esc(title),
                             '<small>{}</small>'.format(esc(location)) if location else ""))
        used += TODAY_ROW_PX
    parts.append("</section>")
    return "".join(parts), used


def upcoming_html(days, budget):
    """(html, last day shown, rows hidden) of the week ahead, compact; a day
    is printed only with at least one row, and once a day is skipped the
    rest of the week is too."""
    parts = ['<section class="upcoming">']
    today = days[0][0]
    shown_through, hidden = today, 0
    for day, rows in days[1:]:
        available = budget - DAY_HEADING_PX
        fit = min(len(rows), max(0, available) // DAY_ROW_PX)
        if fit < len(rows) and available - fit * DAY_ROW_PX < MORE_PX:
            fit -= 1  # make room for the "+N more" line
        if available < 0 or (rows and fit < 1) or shown_through != (day - dt.timedelta(days=1)):
            hidden += len(rows)
            continue
        parts.append('<div class="day"><h3><span>{}</span>{}</h3>'.format(
            day.strftime("%A %-d"), '<span class="none">nothing</span>' if not rows else ""))
        budget -= DAY_HEADING_PX
        shown_through = day
        for label, title, state, inst in rows[:fit]:
            parts.append('<div class="row {}"><div class="time">{}</div><div class="title">{}</div></div>'
                         .format(state, esc(label), esc(title)))
            budget -= DAY_ROW_PX
        if fit < len(rows):
            parts.append('<div class="more">+{} more</div>'.format(len(rows) - fit))
            budget -= MORE_PX
            hidden += len(rows) - fit
        parts.append("</div>")
    parts.append("</section>")
    return "".join(parts), shown_through, hidden


def footer_html(now, days, shown_through, hidden, stale_feeds, feed_count):
    notes = []
    if shown_through != days[-1][0]:
        notes.append("through {}{}".format(shown_through.strftime("%A"),
                                           " · {} more not shown".format(hidden) if hidden else ""))
    if stale_feeds:
        notes.append("{} of {} calendar{} from cache — fetch failed".format(
            stale_feeds, feed_count, "s" if feed_count != 1 else ""))
    return '<footer><span>Updated {}</span><span>{}</span></footer>'.format(clock(now), esc(" · ".join(notes)))


def render_html(days, now, stale_feeds=0, feed_count=1, landscape=False):
    today, today_rows = days[0]
    header = '<div class="head"><div class="weekday">{}</div><div class="date">{}</div></div>'.format(
        today.strftime("%A"), today.strftime("%B %-d, %Y"))
    grid = month_grid_html(today, {day for day, rows in days if rows})
    if landscape:
        today_part, _ = today_html(today_rows, LANDSCAPE_PAGE_PX - LANDSCAPE_LEFT_HEADER_PX - FOOTER_PX)
        week_part, shown_through, hidden = upcoming_html(days, LANDSCAPE_PAGE_PX - FOOTER_PX)
        body = ('<div class="page"><div class="cols"><div class="left">{}{}{}</div><div class="right">{}</div></div>{}</div>'
                .format(header, grid, today_part, week_part,
                        footer_html(now, days, shown_through, hidden, stale_feeds, feed_count)))
    else:
        today_part, used = today_html(today_rows, PORTRAIT_PAGE_PX - PORTRAIT_HEADER_PX - FOOTER_PX)
        week_part, shown_through, hidden = upcoming_html(
            days, PORTRAIT_PAGE_PX - PORTRAIT_HEADER_PX - FOOTER_PX - used)
        body = '<div class="page"><header>{}{}</header>{}{}{}</div>'.format(
            header, grid, today_part, week_part,
            footer_html(now, days, shown_through, hidden, stale_feeds, feed_count))
    return '<!doctype html><meta charset="utf-8"><title>voyage-calendar</title><style>{}</style><body class="{}">{}'.format(
        CSS, "landscape" if landscape else "portrait", body)


